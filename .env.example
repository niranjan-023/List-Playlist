# Copy this file to ".env" and put your real key after the equals sign
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Optional: change the port (default 3000)
# PORT=3000

# ---- MP3 export (all optional) ----
# Only needed if yt-dlp / ffmpeg are not on your PATH
# YTDLP_PATH=C:\tools\yt-dlp.exe
# FFMPEG_PATH=C:\tools\ffmpeg\bin
# Cookies file (Netscape format) if YouTube asks yt-dlp to sign in
# COOKIES_FILE=./cookies.txt
# Max videos per MP3 export (default 100) and parallel conversions (default 2)
# MAX_AUDIO_TRACKS=100
# AUDIO_CONCURRENCY=2
